/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://telegram.org https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ytimg.com; frame-src 'self' https://www.youtube-nocookie.com https://view.officeapps.live.com; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://web.telegram.org

# Vendor kutubxonalari versiyaga bog'langan — uzoq keshlanadi
/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Ilova kodi har deploydan keyin darhol yangilanishi kerak.
# no-cache = keshlanadi, lekin har safar ETag bilan tekshiriladi (arzon).
/js/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

/admin/*
  Cache-Control: no-cache

/pictures/*
  Cache-Control: public, max-age=86400
