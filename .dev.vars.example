# Lokal ishlash uchun maxfiy qiymatlar. Bu faylni `.dev.vars` deb nusxalang.
# Production'da bular Cloudflare dashboard > Pages > Settings >
# Environment variables (Secrets) bo'limiga qo'yiladi.

# ---- Admin panel ----
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "ParolniOzgartiring123!"
SESSION_SECRET = "uzun-tasodifiy-maxfiy-satr-bu-yerga"

# ---- Telegram bot ----
# BotFather bergan token va setWebhook uchun alohida maxfiy satr.
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_WEBHOOK_SECRET = ""
TELEGRAM_OWNER_ID = "123456789"
TELEGRAM_ALLOWED_USER_IDS = "123456789"
TELEGRAM_MAX_PDF_MB = "19"
PUBLIC_SITE_URL = "http://127.0.0.1:8788"

# ---- AI metadata provayderi (Telegram orqali kitob yuklashda) ----
# mock | openai | gemini | anthropic | openrouter
AI_METADATA_PROVIDER = "mock"

# Tanlangan provayder uchungina API key va model kerak.
OPENROUTER_API_KEY = ""
OPENROUTER_METADATA_MODEL = ""
OPENROUTER_SITE_TITLE = "DL-Library"

OPENAI_API_KEY = ""
OPENAI_METADATA_MODEL = ""

GEMINI_API_KEY = ""
GEMINI_METADATA_MODEL = ""

ANTHROPIC_API_KEY = ""
ANTHROPIC_METADATA_MODEL = ""

# ---- Google OAuth (keyingi reliz — hozircha ishlatilmaydi) ----
# Google Cloud Console > Auth Platform > Clients dan olinadi.
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""
# GOOGLE_REDIRECT_URI ixtiyoriy — standart: <origin>/api/user-auth/google/callback
