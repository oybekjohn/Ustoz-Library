{
  "name": "ustoz-library",
  "version": "2.0.0",
  "description": "DL-library.uz — Renessans Ta'lim Universiteti raqamli kutubxonasi (Cloudflare Pages + D1 + R2)",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy public",
    "db:init:local": "wrangler d1 execute ustoz-library-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute ustoz-library-db --remote --file=./schema.sql",
    "db:telegram:local": "wrangler d1 execute ustoz-library-db --local --file=./migrations/0001_telegram_bot.sql",
    "db:telegram:remote": "wrangler d1 execute ustoz-library-db --remote --file=./migrations/0001_telegram_bot.sql",
    "db:telegram-preview:local": "wrangler d1 execute ustoz-library-db --local --file=./migrations/0002_telegram_preview_admins.sql",
    "db:telegram-preview:remote": "wrangler d1 execute ustoz-library-db --remote --file=./migrations/0002_telegram_preview_admins.sql",
    "migrate:local": "node scripts/migrate.mjs --local",
    "migrate:remote": "node scripts/migrate.mjs --remote",
    "telegram:webhook": "node scripts/telegram-webhook.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.1.200"
  }
}
