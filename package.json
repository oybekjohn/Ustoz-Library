{
  "name": "ustoz-library",
  "version": "6.0.0",
  "description": "DL-library.uz — Renessans Ta'lim Universiteti raqamli kutubxonasi (Cloudflare Pages + D1 + R2)",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy public",
    "db:init:local": "wrangler d1 execute ustoz-library-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute ustoz-library-db --remote --file=./schema.sql",
    "db:telegram:local": "wrangler d1 execute ustoz-library-db --local --file=./migrations/0001_telegram_bot.sql",
    "db:telegram:remote": "wrangler d1 execute ustoz-library-db --remote --file=./migrations/0001_telegram_bot.sql",
    "db:telegram-preview:local": "wrangler d1 execute ustoz-library-db --local --file=./migrations/0002_telegram_preview_admins.sql",
    "db:telegram-preview:remote": "wrangler d1 execute ustoz-library-db --remote --file=./migrations/0002_telegram_preview_admins.sql",
    "db:telegram-crud:local": "wrangler d1 execute ustoz-library-db --local --file=./migrations/0003_telegram_book_crud.sql",
    "db:telegram-crud:remote": "wrangler d1 execute ustoz-library-db --remote --file=./migrations/0003_telegram_book_crud.sql",
    "db:remove-group:local": "wrangler d1 execute ustoz-library-db --local --file=./migrations/0004_remove_group_management.sql",
    "db:learning:local": "wrangler d1 execute ustoz-library-db --local --file=./migrations/0005_learning_platform.sql",
    "db:learning:remote": "wrangler d1 execute ustoz-library-db --remote --file=./migrations/0005_learning_platform.sql",
    "db:sync:remote": "wrangler d1 execute ustoz-library-db --remote --file=./migrations/0006_production_sync.sql",
    "db:alter:remote": "wrangler d1 execute ustoz-library-db --remote --file=./migrations/0007_alter_tables.sql",
    "db:v4:local": "wrangler d1 execute ustoz-library-db --local --file=./migrations/0008_catalog_v4.sql",
    "db:v4:remote": "wrangler d1 execute ustoz-library-db --remote --file=./migrations/0008_catalog_v4.sql",
    "catalog:sync:local": "node scripts/sync-catalog-remote.mjs --local",
    "catalog:sync:remote": "node scripts/sync-catalog-remote.mjs",
    "migrate:local": "node scripts/migrate.mjs --local",
    "migrate:remote": "node scripts/migrate.mjs --remote",
    "postinstall": "node scripts/patch-unpdf.mjs",
    "test:pdf-worker": "wrangler dev scripts/pdf-worker-smoke.js --local --port 8799",
    "telegram:webhook": "node scripts/telegram-webhook.mjs",
    "test": "node --test",
    "stamp": "node scripts/stamp-assets.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "unpdf": "1.8.0"
  }
}
